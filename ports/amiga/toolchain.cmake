set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR m68k)
set(CMAKE_C_COMPILER m68k-amigaos-gcc)
set(CMAKE_ASM_COMPILER m68k-amigaos-gcc)
if(ORUNNERS_AMIGA_CPU STREQUAL "68060")
	set(CMAKE_C_FLAGS_INIT "-m68060 -mtune=68060 -mhard-float")
else()
	set(ORUNNERS_AMIGA_CPU 68030)
	set(CMAKE_C_FLAGS_INIT "-m68030 -msoft-float")
endif()
set(CMAKE_ASM_FLAGS_INIT "-m${ORUNNERS_AMIGA_CPU}")
